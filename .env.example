# Think Twice — Environment Variables
# Copy this file to .env.local and fill in your Supabase project values.
#
# INSTRUCTIONS:
#   1. Go to your Supabase project → Settings → API
#   2. Copy the "Project URL" and "anon/public" key
#   3. Paste them below
#   4. Save as .env.local (NOT .env — Next.js loads .env.local automatically)
#
# IMPORTANT: Never commit .env.local to version control.
#            Never use the service_role key here — it must stay server-only.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
